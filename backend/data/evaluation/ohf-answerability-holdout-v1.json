{
  "schema_version": 1,
  "dataset_id": "ohf-answerability-holdout-v1",
  "purpose": "在不回看模型分数的前提下，验证从40题开发集提出的E5相似度拒答候选阈值；不改变知识审核状态，也不代表真实工厂查询分布",
  "product_family_code": "ATV320",
  "frozen_before_first_model_run": true,
  "changes_knowledge_approval_status": false,
  "threshold_policy": {
    "policy_id": "e5-small-answerability-candidate-v1",
    "derived_from_dataset_id": "ohf-retrieval-cases-v2-40",
    "vector_similarity_minimum": 0.86,
    "comparison": "greater_than_or_equal",
    "frozen_before_holdout_run": true
  },
  "acceptance_targets": {
    "answerable_correct_accept_rate_minimum": 0.75,
    "unanswerable_abstain_accuracy_minimum": 1,
    "accepted_precision_minimum": 0.9
  },
